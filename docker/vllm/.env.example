# python3 ../init-env.py creates .env with a random API key.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
BIND_ADDRESS=127.0.0.1
NVIDIA_GPU_ID=0
CHAT_PORT=8000
EMBEDDING_PORT=8001
VLLM_API_KEY=
HF_TOKEN=

VLLM_WSL2_ENABLE_PIN_MEMORY=1

# Starting candidates, NOT the finalized course model. Validate on thr target GPU.
# AWQ is detected from the model configuration. Do not use MLX weights here.
CHAT_MODEL=Qwen/Qwen3-4B-AWQ
CHAT_MODEL_ID=notemind-CHAT_MODEL
CHAT_MAX_MODEL_LEN=8192
CHAT_GPU_MEMORY_UTILIZATION=0.65
CHAT_MAX_NUM_SEQS=4

EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_ID=notemind-embedding
EMBEDDING_MAX_MODEL_LEN=2048
EMBEDDING_GPU_MEMORY_UTILIZATION=0.20
EMBEDDING_MAX_NUM_SEQS=4
